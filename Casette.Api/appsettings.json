{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "AspNetCore": {
      "DefaultOptions": {
        "Endpoint": "http://localhost:18889"
      },
      "MetricsOptions": {
        "Endpoint": "http://localhost:18890",
        "TemporalityPreference": "Delta",
        "PeriodicExportingMetricReaderOptions": {
          "ExportIntervalMilliseconds": 5000
        }
      },
      "TracingOptions": {
        "Endpoint": "http://localhost:18889"
      },
      "LoggingOptions": {
        "Endpoint": "http://localhost:18889"
      }
    }
  }
}
